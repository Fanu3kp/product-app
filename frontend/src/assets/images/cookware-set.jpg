                widgetConfig.theme = {"primaryColor":"#263c27","secondaryColor":"#373737","fontColor":"#000","fontFamily":"\"Work Sans\", sans-serif","backgroundColor":"#FFFFFF","borderColor":"#E5E7EB","launcherGlowColor":"#FFC01D"};
                

                
