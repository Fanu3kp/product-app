<script>
document.getElementsByClassName("simple-search-form")[0].addEventListener("submit", function (e) {
	if ( $( "form.simple-search-form input.search-field" ).val().toLowerCase().indexOf("recipe") > -1 )
	{
	var stmpsearchterm = $( "form.simple-search-form input.search-field" ).val();
		stmpsearchterm = stmpsearchterm.substring( 0, stmpsearchterm.toLowerCase().indexOf("recipe") ).trim();
		$( "form.simple-search-form input.search-field" ).val( stmpsearchterm );
		$( "form.simple-search-form" ).attr( "action", "/recipes" );
	}
});
</script>
