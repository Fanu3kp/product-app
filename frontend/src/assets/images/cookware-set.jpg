                widgetConfig.overridesUrl = "https:\/\/www.cuisinart.com\/on\/demandware.static\/Sites\-us\-cuisinart\-sfra\-Site\/\-\/en_US\/v1793797870705\/js\/acs\/overrides.js";
                

                // Override isOpen/isMinimized from session state if this is a same-site
                // navigation (link click). This makes the widget open immediately with
                // the correct state, avoiding the flash of FAB → open transition.
                (function() {
                    try {
                        var navEntry = performance && performance.getEntriesByType &&
                            performance.getEntriesByType('navigation')[0];
                        if (navEntry && navEntry.type === 'navigate') {
                            var raw = sessionStorage.getItem('cc_panel');
                            if (raw) {
                                var saved = JSON.parse(raw);
                                if (saved.open) {
                                    widgetConfig.componentConfig.isOpen = true;
                                    widgetConfig.componentConfig.isMinimized = false;
                                }
                            }
                        }
                    } catch(e) {}
                })();

                var consent = document.querySelector('.tracking-consent');
                var csrfName = consent && consent.getAttribute('data-tokenName');
                var csrfToken = consent && consent.getAttribute('data-token');

                function postWithCsrf(url, fields) {
                    function fetchOnce() {
                        var body = new URLSearchParams(fields);
                        if (csrfName && csrfToken) { body.append(csrfName, csrfToken); }
                        return fetch(url, {
                            method: 'POST',
                            credentials: 'include',
                            redirect: 'manual',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                            body: body.toString()
                        }).then(function(resp) {
                            if (resp.type === 'opaqueredirect') { return { status: 302, config: null }; }
                            var status = resp.status;
                            return resp.json().catch(function() { return null; })
                                .then(function(cfg) { return { status: status, config: cfg }; });
                        });
                    }

                    return fetchOnce().then(function(result) {
                        if (result.status === 302) { return fetchOnce(); }
                        return result;
                    }).then(function(result) {
                        var cfg = result.config;
                        if (result.status === 401 && cfg && cfg.retryable === true &&
                            cfg.csrfTokenName && cfg.csrfToken) {
                            csrfName = cfg.csrfTokenName;
                            csrfToken = cfg.csrfToken;
                            return fetchOnce();
                        }
                        return result;
                    });
                }

                // ── Session-bound prechat handshake ──────────────────────────────
                // Cimulate emits 'onCimulateWidgetReady' before it creates (or
                // re-creates) a conversation — on mount, session recovery, and
                // reset. We claim the event, fetch fresh encrypted session tokens
                // from CommerceClient-GetPrechatConfig, set them as hidden pre-chat
                // fields, then release the widget, keeping cart management synced
                // across the whole conversation lifecycle.
                (function() {
                    var PRECHAT_URL   = "/on/demandware.store/Sites-us-cuisinart-sfra-Site/en_US/CommerceClient-GetPrechatConfig";

                    window.addEventListener('onCimulateWidgetReady', function(e) {
                        if (!e || !e.detail || typeof e.detail.setHiddenPrechatFields !== 'function') { return; }
                        // Claim the event so the widget waits for done().
                        e.preventDefault();
                        postWithCsrf(PRECHAT_URL).then(function(r) {
                            if (r.status === 200 && r.config && !r.config.error) {
                                // Do not leak the rotating CSRF token into routing attributes.
                                delete r.config.CsrfTokenName;
                                e.detail.setHiddenPrechatFields(r.config);
                            } else {
                                console.warn('[CommerceClient] prechat fetch failed — HTTP', r.status);
                            }
                        }).catch(function(err) {
                            console.warn('[CommerceClient] prechat fetch error', err);
                        }).then(function() {
                            // Always release the widget so a failed fetch can't wedge the chat.
                            e.detail.done();
                        });
                    });
                })();

                // ── Product Result session linking ─────────────────────────────────────
                // The widget calls messagingConfig.onProductResult (detail: { agentSessionId, kind, productIds })
                // when an agent response returns product results — kind is "search" for a
                // product carousel or "detail" for a product tile. Link the MessagingSession
                // id to this ECOM session so downstream analytics can attribute it.
                (function() {
                    var UPDATE_ECOM_SESSION_URL = "/on/demandware.store/Sites-us-cuisinart-sfra-Site/en_US/CommerceClient-UpdateECOMSession";

                    function updateEcomSession(agentSessionId) {
                        postWithCsrf(UPDATE_ECOM_SESSION_URL, { agentSessionId: agentSessionId }).then(function(r) {
                            if (r.status !== 200 || !r.config || r.config.success !== true) {
                                console.warn('[CommerceClient] UpdateECOMSession failed - HTTP', r.status);
                            }
                        }).catch(function(err) {
                            console.warn('[CommerceClient] UpdateECOMSession fetch error', err);
                        });
                    }

                    widgetConfig.messagingConfig.onProductResult = function(detail) {
                        try {
                            if (!detail || !detail.agentSessionId) { return; }
                            updateEcomSession(detail.agentSessionId);
                        } catch (err) {
                            console.error('[CommerceClient] Error handling onProductResult callback', err);
                        }
                    };
                })();

                mod.injectMessagingWidget(widgetConfig);

                // ── CSS custom properties — drive all per-site visual config from BM ──
                var _ccRoot = document.documentElement;
                _ccRoot.style.setProperty('--cc-panel-height', '100dvh');
                _ccRoot.style.setProperty('--cc-panel-top',    '0');

                // ── FAB visibility — hide via body class when cc_showFab = false ──
                

                // ── State: tracks current open/position for page-push + persistence ──
                var CC_KEY        = 'cc_panel';
                var _ccOpen       = false;
                var _ccPos        = "bottom-right";
                var _ccWasOpen    = false; // tracks previous open state to detect open→close transition
                var _ccInitDone   = false; // skip the first isOpen event (widget mount default)

                // ── Page-push: shift body content when panel opens/moves ──
                var _ccPagePush = false;
                function _ccPush() {
                    if (!_ccPagePush) return; // overlay mode — no body shift
                    var b = document.body;
                    b.classList.toggle('cc-panel-open',  _ccOpen);
                    b.classList.toggle('cc-panel-left',  _ccOpen && _ccPos !== 'bottom-right');
                    b.classList.toggle('cc-panel-right', _ccOpen && _ccPos === 'bottom-right');
                }

                // ── Persist state to sessionStorage so it survives page navigation ──
                function _ccSave() {
                    try {
                        sessionStorage.setItem(CC_KEY, JSON.stringify({ open: _ccOpen, pos: _ccPos }));
                    } catch(e) {}
                }

                // ── Restore state after widget mounts on new page ──
                function _ccRestore() {
                    try {
                        var raw = sessionStorage.getItem(CC_KEY);
                        if (!raw) return;
                        var s = JSON.parse(raw);
                        if (!s.open) return;
                        var ns = window.CimulateMessaging || {};
                        var c  = ns.eventHandlers && ns.eventHandlers.components;
                        if (!c) return;
                        if (s.pos && s.pos !== "bottom-right") {
                            c.setWidgetDialogPosition(s.pos);
                        }
                        setTimeout(function() { c.toggleWidgetOpen(true); }, 50);
                    } catch(e) {}
                }

                // ── Listen for widget events ──
                window.addEventListener('cimulate:ui-state-update', function(e) {
                    var d = e && e.detail;
                    if (!d) return;
                    if (d.property === 'isOpen') {
                        // Skip the first isOpen event — it's just the widget mounting with
                        // the ISML-provided componentConfig default, not a real user action.
                        // Without this guard, the mount event overwrites sessionStorage
                        // before _ccRestore() can read the previous page's state.
                        if (!_ccInitDone) { _ccInitDone = true; return; }
                        var _ccPrev = _ccOpen;
                        _ccOpen = Boolean(d.value);
                        _ccPush();
                        _ccSave();
                        // Keep the widget mounted on close and restore its launcher.
                        // Re-injection reloads overrides and duplicates page listeners.
                        
                        if (_ccPrev === true && _ccOpen === false) {
                            var components = mod.eventHandlers && mod.eventHandlers.components;
                            if (components) {
                                components.toggleWidgetOpen(false);
                                components.toggleWidgetMinimized(true);
                            }
                        }
                        
                    }
                    if (d.property === 'position') { _ccPos  = d.value; _ccPush(); _ccSave(); }
                });

                // Restore on SFRA navigation (link click = TYPE_NAVIGATE).
                // Skip restore on fresh loads (direct URL, refresh) so the panel
                // doesn't auto-open unexpectedly.
                // Note: document.referrer is intentionally NOT checked. It can be
                // empty in various scenarios (cross-origin navigations, browser
                // privacy settings) and navType alone is sufficient to distinguish
                // link clicks from refreshes.
                (function() {
                    var navType = performance && performance.getEntriesByType &&
                        performance.getEntriesByType('navigation')[0] &&
                        performance.getEntriesByType('navigation')[0].type;
                    // 'navigate' covers link clicks and form submits; 'reload' and '' skip restore
                    if (navType === 'navigate') {
                        _ccRestore();
                    }
                })();
            }

            if (document.readyState === 'complete') {
                initWidget();
            } else {
                window.addEventListener('load', initWidget);
            }
        })();
    </script>



